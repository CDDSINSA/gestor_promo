# Copiar a .env.local y completar. Detalle en README.md > Variables de entorno.

# Obligatorias
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-publishable-o-anon-key

# Opcionales
# Hosts permitidos, separados por comas (el host de VITE_SUPABASE_URL siempre se permite).
VITE_SUPABASE_ALLOWED_HOSTS=tu-proyecto.supabase.co
# Retorno del correo de recuperacion; debe estar en Redirect URLs de Supabase. Puerto local: 3005.
VITE_SUPABASE_AUTH_REDIRECT_URL=http://localhost:3005/
# Solo desarrollo: "true" carga datos de ejemplo (src/constants/seedData.js).
VITE_USE_DEMO_DATA=false
# Carga por campaña: "true" hace que el inicio no descargue todas las promociones;
# cada pantalla carga solo las campañas que usa. "false" (o vacio) = carga completa
# como antes; es el rollback inmediato si algo falla.
VITE_CARGA_POR_CAMPANA=false
